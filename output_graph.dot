digraph Microservices {
    rankdir=LR;
    graph [fontname="Arial", nodesep=0.5, ranksep=1.2, bgcolor=white, compound=true];
    node [fontname="Arial", fontsize=10, shape=box, style="filled,rounded"];
    edge [fontname="Arial", arrowsize=0.8];

    subgraph cluster_0 {
        label="PostManagementService";
        style="filled,rounded";
        fillcolor="#ccd2c6";
        fontname="Arial Bold";
        fontsize=12;
        "MicropostTest_setup" [label="MicropostTest\n.setup()", fillcolor=white];
