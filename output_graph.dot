    "User_authenticated?" -> "UsersController_new" [color="#95A5A6", weight=2];
    "User_send_activation_email" -> "UserMailer_account_activation" [color="#E74C3C", style=dashed, weight=1];
    "User_send_password_reset_email" -> "UserMailer_password_reset" [color="#E74C3C", style=dashed, weight=1];
    "PasswordResetsController_create" -> "User_create_reset_digest" [color="#95A5A6", weight=2];
    "PasswordResetsController_create" -> "User_send_password_reset_email" [color="#95A5A6", weight=2];
