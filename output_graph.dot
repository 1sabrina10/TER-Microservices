    "StaticPagesController_home" -> "User_feed" [color="#95A5A6", weight=2];
    "UsersController_new" -> "PasswordResetsController_new" [color="#95A5A6", weight=2];
    "UsersController_new" -> "SessionsController_new" [color="#95A5A6", weight=2];
