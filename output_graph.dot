digraph Microservices {
    rankdir=LR;
    graph [fontname="Arial", nodesep=0.5, ranksep=1.0, bgcolor=white];
    node [fontname="Arial", fontsize=10, shape=box, style="filled,rounded"];
    edge [fontname="Arial", arrowsize=0.8];

    subgraph cluster_0 {
        label="CreateCommentsService";
        style="filled,rounded";
        fillcolor="#b9e3d3";
        fontname="Arial Bold";
        "CreateComments_change" [label="change", fillcolor=white];
    }

    subgraph cluster_1 {
