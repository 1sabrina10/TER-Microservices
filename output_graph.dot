    "User_complete_task" -> "User_check_project_completion" [color="#95A5A6"];
    "Notification_send_email_if_critical" -> "TaskMailer_notification_email" [color="#E74C3C", style=dashed];
    "UsersController_new" -> "SessionsController_new" [color="#E74C3C", style=dashed];
    "UsersController_new" -> "TasksController_new" [color="#E74C3C", style=dashed];
    "UsersController_new" -> "UsersController_new" [color="#95A5A6"];
    "UsersController_new" -> "ProjectsController_new" [color="#E74C3C", style=dashed];
    "UsersController_create" -> "SessionsController_new" [color="#E74C3C", style=dashed];
    "UsersController_create" -> "TasksController_new" [color="#E74C3C", style=dashed];
    "UsersController_create" -> "UsersController_new" [color="#95A5A6"];
    "UsersController_create" -> "ProjectsController_new" [color="#E74C3C", style=dashed];
    "ProjectsController_new" -> "SessionsController_new" [color="#E74C3C", style=dashed];
    "ProjectsController_new" -> "TasksController_new" [color="#E74C3C", style=dashed];
    "ProjectsController_new" -> "UsersController_new" [color="#E74C3C", style=dashed];
    "ProjectsController_new" -> "ProjectsController_new" [color="#95A5A6"];
}
